rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isSelf(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function email() {
      return signedIn() && request.auth.token.email is string
        ? request.auth.token.email.lower()
        : '';
    }

    function isOwnerEmail() {
      return email() == 'grokaia94@gmail.com';
    }

    function profileDoc() {
      return /databases/\( (database)/documents/profiles/ \)(request.auth.uid);
    }

    function userDoc() {
      return /databases/\( (database)/documents/users/ \)(request.auth.uid);
    }

    function isAdmin() {
      return signedIn() && (
        isOwnerEmail()
        || (exists(profileDoc()) && get(profileDoc()).data.role == 'admin')
        || (exists(userDoc()) && get(userDoc()).data.role == 'admin')
      );
    }

    function isStaff() {
      return signedIn() && (
        (exists(profileDoc()) && get(profileDoc()).data.role == 'staff')
        || (exists(userDoc()) && get(userDoc()).data.role == 'staff')
      );
    }

    function isDesk() {
      return isAdmin() || isStaff();
    }

    function orderStatusOf(data) {
      return data.keys().hasAny(['orderStatus'])
        ? data.orderStatus
        : data.status;
    }

    match /coupons/{couponId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /categories/{categoryId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /products/{productId} {
      allow read: if true;
      allow create, update: if isDesk();
      allow delete: if isAdmin();
    }

    match /orders/{orderId} {
      allow read: if isDesk()
        || (signedIn() && resource.data.userId == request.auth.uid)
        || (signedIn() && resource.data.email is string
            && email() != ''
            && resource.data.email.lower() == email());
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid
        && orderStatusOf(request.resource.data) in ['placed', 'confirmed'];
      allow update: if isDesk();
      allow delete: if isAdmin();
    }

    match /users/{userId} {
      allow read: if isAdmin()
        || isSelf(userId)
        || (signedIn() && resource.data.uid == request.auth.uid);
      allow create: if (isSelf(userId)
          && (
            request.resource.data.role == 'customer'
            || (request.resource.data.role == 'admin' && isOwnerEmail())
          ))
        || (isAdmin() && request.resource.data.role in ['customer', 'staff']);
      allow update: if isAdmin()
        || (isSelf(userId) && request.resource.data.role == resource.data.role)
        || (isSelf(userId) && isOwnerEmail() && request.resource.data.role == 'admin');
      allow delete: if isAdmin();
    }

    match /handles/{handleId} {
      allow get: if true;
      allow list: if isAdmin();
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid;
      allow update, delete: if isAdmin()
        || (signedIn() && resource.data.uid == request.auth.uid);
    }

    match /supportThreads/{threadId} {
      allow get: if true;
      allow list: if isDesk();
      allow create: if request.resource.data.visitorId is string
        && request.resource.data.visitorId.size() >= 8
        && request.resource.data.visitorId.size() <= 64
        && request.resource.data.status == 'open';
      allow update: if isDesk()
        || request.resource.data.visitorId == resource.data.visitorId;
      allow delete: if isAdmin();

      match /messages/{messageId} {
        allow read: if true;
        allow create: if (
          request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 1000
          && (
            (request.resource.data.from == 'customer')
            || (isDesk() && request.resource.data.from == 'staff')
          )
        );
        allow update, delete: if isAdmin();
      }
    }


    match /supportChats/{uid} {
      allow read: if true;
      allow create, update: if request.auth != null && request.auth.uid == uid;
      allow delete: if false;
    }

    match /profiles/{userId} {
      allow read: if isSelf(userId) || isAdmin();
      allow create: if (isSelf(userId)
          && (
            request.resource.data.role == 'customer'
            || (request.resource.data.role == 'admin' && isOwnerEmail())
          ))
        || (isAdmin() && request.resource.data.role in ['customer', 'staff']);
      allow update: if isAdmin()
        || (isSelf(userId) && request.resource.data.role == resource.data.role)
        || (isSelf(userId) && isOwnerEmail() && request.resource.data.role == 'admin');
      allow delete: if isAdmin();
    }
  }
}